# Copy to .env for local use. Never commit real credentials.
APP_ENV=development
ALLOWED_ORIGINS=https://codementor-ai-dev.web.app,http://localhost:5173,http://localhost:5500
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Alternatively provide the service account JSON as an environment variable.
# FIREBASE_CREDENTIALS=
PISTON_API_URL=https://emkc.org/api/v2/piston
# For multiple instances, configure a shared Redis URL; memory:// is the default.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
